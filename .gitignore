# Build output
main

# Runtime-generated problem data; keep the templates/placeholders below.
data/*/*
!data/answer/.gitkeep
!data/dot/.gitkeep
!data/html/.gitkeep
!data/image/.gitkeep
!data/input/.gitkeep
!data/problem/.gitkeep
!data/record/.gitkeep

# Runtime-generated images and downloadable PDFs.
images/*
!images/dijkstra.png
static/*.pdf
